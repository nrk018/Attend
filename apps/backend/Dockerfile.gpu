# GPU support for face recognition (Linux + NVIDIA CUDA)
# Requires: nvidia-docker or Docker with GPU support
# Build: docker build -f Dockerfile.gpu -t attend-backend-gpu .
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1-mesa-glx \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-gpu.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-gpu.txt

COPY . .
EXPOSE 8000

ENV FACE_EXECUTION_PROVIDER=cuda
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
