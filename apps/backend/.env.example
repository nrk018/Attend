SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-change-in-production

# Email (Resend) - required for new user verification
RESEND_API_KEY=re_xxx
# After verifying domain at resend.com/domains, set: RESEND_FROM_EMAIL="Attend <noreply@yourdomain.com>"
# RESEND_FROM_EMAIL="Attend <onboarding@resend.dev>"
APP_BASE_URL=http://localhost:8000

# Face recognition (optional)
RECOGNITION_THRESHOLD=0.5
# auto | cuda | coreml | cpu - use cuda on GPU instance, cpu otherwise
FACE_EXECUTION_PROVIDER=auto
