SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-change-in-production

# Email (Resend) - required for new user verification
RESEND_API_KEY=re_xxx
# After verifying domain at resend.com/domains, set: RESEND_FROM_EMAIL="Attend <noreply@buildit.club>"
# Production VPS: APP_BASE_URL=https://api.builditmuj.club
# RESEND_FROM_EMAIL="Attend <onboarding@resend.dev>"
APP_BASE_URL=http://localhost:8000
# Student registration portal (email verify links)
STUDENT_WEB_URL=http://localhost:5174

# Comma-separated extra CORS origins for Electron (Origin: null) and production hosts
CORS_ORIGINS=null

# Face recognition (optional)
RECOGNITION_THRESHOLD=0.5
AUTO_ENROLL_THRESHOLD=0.5
# auto | cuda | coreml | cpu - use cuda on GPU instance, cpu otherwise
FACE_EXECUTION_PROVIDER=auto
