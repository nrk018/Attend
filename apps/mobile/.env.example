# Backend API URL (used only on physical device)
# Emulator/simulator: auto-detected (localhost for iOS, 10.0.2.2 for Android)
# Physical device: set to your computer's LAN IP, e.g. http://192.168.1.100:8000
# Find IP: macOS `ipconfig getifaddr en0` or System Settings → Network
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
